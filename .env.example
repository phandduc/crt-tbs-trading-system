# Sao chép thành .env rồi điền. KHÔNG commit .env.

# Telegram (để trống → chỉ in ra màn hình)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MT5 (để trống → dùng terminal MT5 đang đăng nhập sẵn)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Tên mã CHÍNH XÁC như trên Market Watch, cách nhau bởi dấu phẩy (BCR-MT5 dùng hậu tố .s)
SYMBOLS=EURUSD.s,GBPUSD.s,AUDUSD.s,XAUUSD.s

# false = chỉ báo tín hiệu qua Telegram; true = tự đặt lệnh (chỉ tài khoản Demo)
AUTO_TRADE=false
RISK_PERCENT=1.0

# Giờ sàn lệch UTC bao nhiêu giờ (BCR-MT5 = 0). Nến D phải đóng 17:00 New York như backtest.
SERVER_UTC_OFFSET_HOURS=0

# Cho phép AUTO_TRADE trên tài khoản thật — chiến lược CHƯA đạt tiêu chí backtest, để false
ALLOW_REAL_ACCOUNT=false
